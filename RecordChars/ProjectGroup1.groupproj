<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{4F6E7C59-5A9E-4108-BA02-4C1A67A29F06}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="RecordChars.cbproj">
            <Dependencies/>
        </Projects>
        <Projects Include="..\WhoIsSpeaking\WhoIsSpeaking.cbproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="RecordChars">
        <MSBuild Projects="RecordChars.cbproj"/>
    </Target>
    <Target Name="RecordChars:Clean">
        <MSBuild Projects="RecordChars.cbproj" Targets="Clean"/>
    </Target>
    <Target Name="RecordChars:Make">
        <MSBuild Projects="RecordChars.cbproj" Targets="Make"/>
    </Target>
    <Target Name="WhoIsSpeaking">
